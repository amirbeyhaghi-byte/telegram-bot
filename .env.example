# ===== ربات (برای تست از یک ربات جدا در BotFather استفاده کنید، نه ربات اصلی) =====
BOT_TOKEN=توکن ربات تستی

# ===== دیتابیس MySQL / MariaDB (در XAMPP: کاربر root با رمز خالی) =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=beyhaghi_php
DB_USER=root
DB_PASS=

# ===== مدیر =====
ADMIN_PHONE=09120000000
ADMIN_TELEGRAM_ID=123456789

# ===== اتصال به تلگرام از ایران (فقط روی کامپیوتر خودتان لازم است) =====
# اگر فیلترشکن شما پورت پروکسی محلی دارد، آدرسش را اینجا بگذارید (مثلاً v2rayN: socks5://127.0.0.1:10808).
# اگر کل سیستم با فیلترشکن کار می‌کند، خالی بگذارید.
TELEGRAM_PROXY=
TELEGRAM_IPV4=1
# اگر در ویندوز خطای «SSL certificate problem» گرفتید، مسیر فایل CA را بدهید (در XAMPP معمولاً C:\xampp\apache\bin\curl-ca-bundle.crt)
TELEGRAM_CA_BUNDLE=
TELEGRAM_VERIFY_SSL=1

# ===== فقط برای هاست (انتقال نهایی) =====
# WEBHOOK_URL=https://دامنه-شما/webhook.php
# WEBHOOK_SECRET=یک-رشته-تصادفی-حداقل-۱۶-کاراکتر-لاتین

# نمایش خطا در کنسول (1 = روشن). پیش‌فرض بدون هیچ لاگ فایلی.
APP_DEBUG=1

# ===== پرداخت کارت‌به‌کارت (برای فعال‌شدن خرید اشتراک) =====
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_BANK=
PAYMENT_CARD_OWNER=
